# Database (Northflank injects this when the Postgres addon is linked)
DATABASE_URL=

# Redis (leave unset on free tier — timerStore uses in-memory fallback)
# REDIS_URL=

# Frontend service public URL (for CORS + Socket.io origin)
FRONTEND_URL=

# Telegram bot (optional — for future notifications)
TELEGRAM_BOT_TOKEN=

# Session signing secret (generate a long random string)
SESSION_SECRET=

# Internal socket emit URL (defaults to http://127.0.0.1:$PORT — same process)
# SOCKET_INTERNAL_URL=

NODE_ENV=production

# Northflank sets PORT automatically — do not set manually
# PORT=
