generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoomMode {
  FREE_MARKET
  HERO_DRAFT
}

enum PlayerTier {
  GOLD
  HERO
  ICON
}

model Room {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  /// FREE_MARKET (original auction) | HERO_DRAFT
  mode          RoomMode @default(FREE_MARKET)
  phase         String   @default("lobby")
  currentSeason Int      @default(1)
  settings      RoomSettings?
  heroDraftSettings HeroDraftSettings?
  heroDraftState    HeroDraftState?
  draftRoundHistory DraftRoundHistory[]
  forcedPlayerReleases ForcedPlayerRelease[]
  users         User[]
  players       Player[]
  auctions      Auction[]
  trades        TradeRequest[]
  loans         Loan[]
  matches       Match[]
  cards         Card[]
  awards        Award[]
  iconBoxes     IconBox[]
  marketEffects MarketEffect[]
  createdAt     DateTime @default(now())
}

model RoomSettings {
  id                        String   @id @default(cuid())
  room                      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId                    String   @unique
  startingBudget            Int      @default(400000000)
  bidTimerSeconds           Int      @default(60)
  deadlineBidTimerSeconds   Int      @default(20)
  deadlineDayEnabled        Boolean  @default(true)
  deadlineStartsAt          DateTime?
  deadlineEndsAt            DateTime?
  transferWindowEndsAt      DateTime?
  rebidRoundEnabled         Boolean  @default(false)
  enabledCardTypes          String[] @default([])
  streakBonusEnabled        Boolean  @default(true)
  streakBonusAt3            Int      @default(15000000)
  streakBonusAt5            Int      @default(30000000)
  leaguePrizeFirst          Int      @default(50000000)
  leaguePrizeSecond         Int      @default(25000000)
  telegramWebhookUrl        String?
  tradingEnabledDuringLeague Boolean @default(false)
  allowSquadOverflowForIcons Boolean @default(false)
}

model User {
  id                String   @id @default(cuid())
  room              Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId            String
  displayName       String
  teamName          String
  pin               String?
  isAdmin           Boolean  @default(false)
  budget            Int
  currentStreak     Int      @default(0)
  currentStreakType String?
  bestStreakSeason  Int      @default(0)
  squadPlayers      SquadPlayer[]
  bids              Bid[]
  cards             Card[]
  iconBoxes         IconBox[]
  homeMatches       Match[]  @relation("home")
  awayMatches       Match[]  @relation("away")
  createdAt         DateTime @default(now())
}

model Player {
  id            String   @id @default(cuid())
  room          Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId        String
  name          String
  realTeam      String
  league        String?
  position      String
  baseRating    Int
  boostedRating Int?
  /// FC face stats raised by bot boost: [{ key, label, bump }] — PAC/SHO… or GK DIV/HAN…
  boostedStats  Json?
  marketValue   Int
  status        String   @default("available")
  /// When this listing window ends (available players only). Resets for another 12h if no auction starts.
  listingEndsAt DateTime?
  /// Source of truth for rarity. isIcon/isHero kept in sync as legacy mirrors.
  tier          PlayerTier @default(GOLD)
  isIcon        Boolean  @default(false)
  isHero        Boolean  @default(false)
  squadEntry    SquadPlayer?
  auctions      Auction[]
  loans         Loan[]

  @@index([roomId, status, isIcon, isHero])
  @@index([roomId, isIcon, isHero])
  @@index([roomId, status, tier, position])
}

model SquadPlayer {
  id            String  @id @default(cuid())
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  player        Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId      String  @unique
  isStarting    Boolean @default(false)
  purchasePrice Int
  /// Hero Draft slot index 0-17 (null for free-market squads)
  draftSlotIndex Int?
  /// How this player was acquired in Hero Draft
  draftAcquisition String? // "auction" | "random_roll" | "downgrade" | "trade"
}

model Auction {
  id              String   @id @default(cuid())
  room            Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId          String
  player          Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId        String
  startingPrice   Int
  currentBid      Int
  currentBidderId String?
  sellerId        String?  // set on resale — who receives the sale money
  status          String   @default("active")
  isResale        Boolean  @default(false)
  endsAt          DateTime
  bids            Bid[]
  createdAt       DateTime @default(now())

  @@index([roomId, status, endsAt])
  @@index([playerId, status])
  @@index([status, currentBidderId])
}

model Bid {
  id        String   @id @default(cuid())
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  auctionId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  amount    Int
  createdAt DateTime @default(now())
}

model TradeRequest {
  id                 String   @id @default(cuid())
  room               Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId             String
  fromUserId         String
  toUserId           String
  offeredPlayerIds   String[]
  requestedPlayerIds String[]
  cashAdjustment     Int      @default(0)
  status             String   @default("pending")
  createdAt          DateTime @default(now())
}

/// Temporary player loan — lender keeps ownership; borrower uses player for N fixtures.
model Loan {
  id               String    @id @default(cuid())
  room             Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId           String
  season           Int
  lenderId         String
  borrowerId       String
  player           Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId         String
  loanFee          Int       @default(0)
  fixturesTotal    Int
  fixturesPlayed   Int       @default(0)
  borrowerIsStarting Boolean @default(false)
  status           String    @default("pending")
  createdAt        DateTime  @default(now())
  acceptedAt       DateTime?
  returnedAt       DateTime?
}

model Match {
  id            String  @id @default(cuid())
  room          Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId        String
  season        Int
  homeUser      User    @relation("home", fields: [homeUserId], references: [id], onDelete: Cascade)
  homeUserId    String
  awayUser      User    @relation("away", fields: [awayUserId], references: [id], onDelete: Cascade)
  awayUserId    String
  homeScore     Int?
  awayScore     Int?
  status        String  @default("scheduled")
  reportedById  String?
  confirmedById String?
  homeBonusPts  Int     @default(0)
  awayBonusPts  Int     @default(0)
}

model Card {
  id        String   @id @default(cuid())
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId    String
  owner     User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId   String?
  type      String
  /// "transfer" (market) | "fixture" (league) — 3 fixture cards last the whole league
  category  String   @default("transfer")
  used      Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
}

model Award {
  id     String @id @default(cuid())
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId String
  season Int
  type   String
  userId String
  value  String
}

model IconBox {
  id                String   @id @default(cuid())
  room              Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  season            Int
  /// "icon" | "hero"
  kind              String   @default("icon")
  boxNumber         Int
  optionAId         String
  optionBId         String
  revealedOptionA   Boolean  @default(false)
  revealedOptionB   Boolean  @default(false)
  chosenOptionId    String?
  status            String   @default("pending")
  createdAt         DateTime @default(now())
}

// Timed / pending transfer-card effects applied to the market
model MarketEffect {
  id           String    @id @default(cuid())
  room         Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId       String
  type         String
  casterId     String
  targetUserId String?
  playerId     String?
  auctionId    String?
  expiresAt    DateTime?
  payload      Json?
  createdAt    DateTime  @default(now())
}

/// Per-room Hero Draft configuration (created when mode = HERO_DRAFT)
model HeroDraftSettings {
  id                      String  @id @default(cuid())
  room                    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId                  String  @unique
  startingBudget          Int     @default(500000000)
  bidTimerSeconds         Int     @default(60)
  tierWeightGold          Int     @default(70)
  tierWeightHero          Int     @default(25)
  tierWeightIcon          Int     @default(5)
  goldenRoundMinRating    Int     @default(80)
  turnHolderMustOpenBid   Boolean @default(true)
  bidTurnTimeoutSeconds   Int     @default(20)
  /// Fraction of final winning price charged to pure passers
  passiveDeductionRatio   Float   @default(0.5)
  tradeWindowMinutes      Int     @default(30)
  /// Admin can skip trade window after draft
  tradeWindowEnabled      Boolean @default(true)
}

/// Live Hero Draft state machine for one room
model HeroDraftState {
  id                          String    @id @default(cuid())
  room                        Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId                      String    @unique
  /// not_started | in_progress | awaiting_releases | trade_window | completed
  status                      String    @default("not_started")
  currentRound                Int       @default(0)
  goldenRoundIndex            Int?
  turnQueue                   String[]
  turnQueuePointer            Int       @default(0)
  biddingOrder                String[]
  slotTemplate                Json
  filledSlotIndexes           Int[]     @default([])
  tierWeights                 Json
  goldenRoundMinRating        Int       @default(80)
  tradeWindowEndsAt           DateTime?

  /// Live sequential bidding for the CURRENT round
  currentSlotIndex            Int?
  currentAuctionedPlayerId    String?
  currentTurnHolderId         String?
  currentRoundActiveBidders   String[]  @default([])
  currentRoundPassedBidders   String[]  @default([])
  /// Map userId → last bid amount this round (JSON object)
  currentRoundLastBids        Json?
  currentRoundHighestBid      Int?
  currentRoundHighestBidderId String?
  currentRoundTurnUserId      String?
  currentRoundTurnExpiresAt   DateTime?
  /// Users who still owe a forced release before round can advance
  pendingReleaseUserIds       String[]  @default([])
  updatedAt                   DateTime  @updatedAt
  createdAt                   DateTime  @default(now())
}

model ForcedPlayerRelease {
  id                 String   @id @default(cuid())
  room               Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId             String
  userId             String
  roundIndex         Int
  releasedPlayerId   String
  refundAmount       Int
  downgradeSlotIndex Int
  downgradePlayerId  String
  createdAt          DateTime @default(now())

  @@index([roomId, userId])
}

model DraftRoundHistory {
  id                String   @id @default(cuid())
  room              Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId            String
  roundIndex        Int
  slotIndex         Int
  slotPosition      String
  isGoldenRound     Boolean  @default(false)
  auctionedPlayerId String
  turnHolderId      String
  winnerId          String
  winningBid        Int
  /// ordered array of { userId, passedAtBidAmount, lastBidAmount }
  passOrder         Json
  /// array of { userId, playerId, tier, rating, lastBidAmount, deductionAmount, deductionType }
  randomRolls       Json
  createdAt         DateTime @default(now())

  @@unique([roomId, roundIndex])
  @@index([roomId])
}
