# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/fc26_auction?schema=public"

# Redis (optional — only used when REDIS_URL is set; leave unset on Northflank free tier)
# REDIS_URL="redis://localhost:6379"

# Session secret (generate a random string, 32+ characters)
SESSION_SECRET="change-me-to-a-long-random-string"

# --- Local monolith dev (repo root) ---
SOCKET_PORT=3001
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
SOCKET_INTERNAL_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Northflank backend service (/backend) ---
# FRONTEND_URL="https://frontend--project--team.code.run"
# TELEGRAM_BOT_TOKEN=
# NODE_ENV=production
# PORT is set by Northflank — do not set manually

